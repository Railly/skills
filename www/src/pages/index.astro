---
import Catalog from "../components/Catalog.astro";
import EvidenceKey from "../components/EvidenceKey.astro";
import Hero from "../components/Hero.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WorkflowGraph from "../components/WorkflowGraph.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Railly Skills: Engineering skills with receipts"
	description="Evidence-driven agent skills shaped by real engineering work. Inspect maturity, source, limits, and installation from one registry."
>
	<div id="top"></div>
	<SiteHeader />
	<main id="main-content">
		<Hero />
		<WorkflowGraph />
		<Catalog />
		<EvidenceKey />
	</main>
	<SiteFooter />
	<div class="copy-toast" data-copy-toast role="status" aria-live="polite" aria-atomic="true"></div>
</Layout>

<script>
	const toast = document.querySelector<HTMLElement>("[data-copy-toast]");
	let toastTimer = 0;

	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
		button.addEventListener("click", async () => {
			const command = button.dataset.copy;
			if (!command) return;
			try {
				await navigator.clipboard.writeText(command);
				const label = button.querySelector<HTMLElement>("[data-copy-label]");
				if (label) label.textContent = "Copied";
				if (toast) {
					toast.textContent = "Install command copied";
					toast.dataset.visible = "true";
				}
				window.clearTimeout(toastTimer);
				toastTimer = window.setTimeout(() => {
					if (label) label.textContent = "Copy";
					if (toast) delete toast.dataset.visible;
				}, 1800);
			} catch {
				if (toast) {
					toast.textContent = "Copy failed. Select the command manually.";
					toast.dataset.visible = "true";
				}
			}
		});
	}
</script>
