---
import { channelCounts, collectionInstallCommand, evaluatedCount, release, skills } from "../data/skills";
---

<section class="hero shell" aria-labelledby="hero-title">
	<div class="hero-copy">
		<p class="eyebrow"><span class="status-dot"></span> Open engineering methods · v{release}</p>
		<h1 id="hero-title">Engineering skills with receipts.</h1>
		<p class="hero-lede">
			Portable methods shaped by real maintenance work. Inspect source, channel, evidence, and limits.
		</p>
		<div class="hero-tools">
			<div class="command-block" role="group" aria-label="Install Railly Skills">
				<span aria-hidden="true">$</span>
				<code>{collectionInstallCommand}</code>
				<button type="button" data-copy={collectionInstallCommand} aria-label="Copy collection install command">
					<span data-copy-label>Copy</span>
				</button>
			</div>
			<a class="source-link" href="https://github.com/Railly/skills" target="_blank" rel="noreferrer">Source ↗</a>
		</div>
	</div>

	<div class="release-strip" role="region" aria-label="Release evidence summary">
		<div><span>registry</span><strong>foundry/maturity.json</strong></div>
		<div><span>methods</span><strong>{skills.length}</strong></div>
		<div><span>stable</span><strong>{channelCounts.stable}</strong></div>
		<div><span>candidate</span><strong>{channelCounts.candidate}</strong></div>
		<div><span>experimental</span><strong>{channelCounts.experimental}</strong></div>
		<div><span>evaluated</span><strong>{evaluatedCount}</strong></div>
	</div>
</section>
