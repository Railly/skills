---
const steps = [
	{ id: "01", name: "Select", skill: "issue-intake", note: "optional" },
	{ id: "02", name: "Contract", skill: "contract", note: "done criteria" },
	{ id: "03", name: "Shape", skill: "solution-gate", note: "heavy only" },
	{ id: "04", name: "Implement", skill: "loop", note: "method" },
	{ id: "05", name: "Observe", skill: "observe.sh", note: "evidence" },
	{ id: "06", name: "Review", skill: "review-gate", note: "verdict" },
	{ id: "07", name: "Show", skill: "before-after", note: "heavy only" },
	{ id: "08", name: "Promote", skill: "human decision", note: "authority" },
	{ id: "09", name: "Deliver", skill: "ship", note: "external" },
	{ id: "10", name: "Record", skill: "record-a-case", note: "ledger" },
];
---

<section id="workflow" class="workflow section-shell" aria-labelledby="workflow-title">
	<div class="section-heading">
		<div>
			<p class="eyebrow">Workflow</p>
			<h2 id="workflow-title">A verified loop, not a prompt collection.</h2>
		</div>
		<p><code>loop</code> enters at the earliest step whose evidence is stale. Open work can hand off and re-enter.</p>
	</div>

	<div class="workflow-board" tabindex="0" role="region" aria-label="Engineering workflow, scroll horizontally to inspect every step">
		<ol class="workflow-steps">
			{steps.map((step) => (
				<li>
					<span class="step-index">{step.id}</span>
					<div><strong>{step.name}</strong><code>{step.skill}</code></div>
					<small>{step.note}</small><span class="step-arrow" aria-hidden="true">→</span>
				</li>
			))}
		</ol>
		<div class="handoff-loop">
			<strong>Cycle open?</strong><code>handoff → workstream-reconcile → earliest incomplete state</code>
		</div>
	</div>
</section>
