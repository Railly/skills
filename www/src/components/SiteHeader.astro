---
import { release } from "../data/skills";
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="brand" href="#top" aria-label="Railly Skills home">
			<svg aria-hidden="true" viewBox="0 0 219 249" width="25" height="28" fill="none">
				<path d="M104.586 8.324C107.627 6.559 111.373 6.559 114.414 8.324L207.086 62.132C210.127 63.898 212 67.161 212 70.692V178.308C212 181.839 210.127 185.102 207.086 186.868L114.414 240.676C111.373 242.441 107.627 242.441 104.586 240.676L11.915 186.868C8.873 185.102 7 181.839 7 178.308V70.692C7 67.161 8.873 63.898 11.915 62.132L104.586 8.324Z" stroke="currentColor" stroke-width="13"></path>
				<path d="M108.5 13.5C154.5 52.333 218.9 151.3 108.5 236.5M12.5 68l93 165M12 183l93-165" stroke="currentColor" stroke-width="10" stroke-linecap="round"></path>
			</svg>
			<span>Railly / Skills</span>
		</a>
		<nav aria-label="Primary navigation">
			<a href="#workflow">Workflow</a>
			<a href="#catalog">Catalog</a>
			<a href="https://github.com/Railly/skills" target="_blank" rel="noreferrer">GitHub</a>
		</nav>
		<div class="header-meta">
			<span>v{release}</span>
			<button class="theme-switch" type="button" data-theme-switch aria-label="Change color theme">
				<svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16">
					<path d="M10 2v2m0 12v2M2 10h2m12 0h2M4.34 4.34l1.42 1.42m8.48 8.48 1.42 1.42m0-11.32-1.42 1.42m-8.48 8.48-1.42 1.42" fill="none" stroke="currentColor" stroke-linecap="round"></path>
					<circle cx="10" cy="10" r="3" fill="none" stroke="currentColor"></circle>
				</svg>
				<span data-theme-label>System</span>
			</button>
		</div>
	</div>
</header>

<script>
	const themeButton = document.querySelector<HTMLButtonElement>("[data-theme-switch]");
	const themeLabel = document.querySelector<HTMLElement>("[data-theme-label]");
	const themes = ["system", "light", "dark"] as const;

	const currentTheme = () => document.documentElement.dataset.theme ?? "system";
	const renderTheme = () => {
		if (themeLabel) themeLabel.textContent = `${currentTheme()[0].toUpperCase()}${currentTheme().slice(1)}`;
	};

	themeButton?.addEventListener("click", () => {
		const index = themes.indexOf(currentTheme() as (typeof themes)[number]);
		const next = themes[(index + 1) % themes.length];
		if (next === "system") {
			delete document.documentElement.dataset.theme;
			localStorage.removeItem("railly-skills-theme");
		} else {
			document.documentElement.dataset.theme = next;
			localStorage.setItem("railly-skills-theme", next);
		}
		renderTheme();
	});

	renderTheme();
</script>
