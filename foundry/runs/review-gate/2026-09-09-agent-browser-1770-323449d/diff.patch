+            &effective_session_id,
+            &object_id,
+            ARIA_STATE_FUNCTION,
+            Some(serde_json::json!(values)),
+            target,
+        )
+        .await
+        {
+            Ok(state) => state,
+            Err(error) if is_stale_selection_error(&error) => {
+                if tokio::time::Instant::now() >= deadline {
+                    return Err(selection_error(
+                        target,
+                        "the control rerendered during inspection",
+                    ));
+                }
