+            {
+                Ok(resolved) => resolved,
+                Err(error) if is_stale_selection_error(&error) => {
+                    if tokio::time::Instant::now() >= deadline {
+                        return Err(selection_error(
+                            target,
+                            "the control rerendered before inspection",
