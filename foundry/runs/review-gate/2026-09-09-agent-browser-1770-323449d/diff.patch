+                        const frameRect = win.frameElement.getBoundingClientRect();
+                        x += frameRect.x + win.frameElement.clientLeft;
+                        y += frameRect.y + win.frameElement.clientTop;
+                        win = win.parent;
+                    }
+                }
+                return { x, y };
