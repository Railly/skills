+fn write_dashboard_config(config: &DashboardConfig) -> std::io::Result<()> {
+    let contents = serde_json::to_vec(config).map_err(std::io::Error::other)?;
+    let path = get_dashboard_config_path();
+
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
