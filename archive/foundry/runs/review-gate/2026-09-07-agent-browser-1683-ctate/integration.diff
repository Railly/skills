+fn parse_dashboard_command(args: &[String]) -> Result<DashboardCommand, String> {
+    let (subcommand, mut index) = match args.first().map(String::as_str) {
+        Some("start") => ("start", 1),
+        Some("stop") => ("stop", 1),
