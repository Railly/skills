+        tokio::time::timeout(std::time::Duration::from_secs(5), async {
+            loop {
+                if methods.lock().await.iter().any(|method| method == expected) {
+                    break;
+                }
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("timed out waiting for CDP method");
+    }
 
