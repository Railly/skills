+        .get("description")
+        .and_then(|v| v.as_str())
+        .unwrap_or("");
+    let frame = tool.get("frameId").and_then(|v| v.as_str()).unwrap_or("?");
+    let origin = tool
+        .get("origin")
+        .and_then(|v| v.as_str())
+        .unwrap_or("unknown");
+    format!("{} [{}]\n  {}\n  {}", name, frame, description, origin)
+}
