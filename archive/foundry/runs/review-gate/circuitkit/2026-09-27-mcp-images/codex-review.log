    37	    { description: "Interactive circuit selection and teaching scenes.", _meta: { ui } },
    38	    async () => {
    39	      audit("resource-read", { uri: CIRCUIT_UI_URI });
    40	      return {
    41	        contents: [
    42	          { uri: CIRCUIT_UI_URI, mimeType: RESOURCE_MIME_TYPE, text: html, _meta: { ui } },
    43	        ],
    44	      };
    45	    },
    46	  );
    47	  const render =
    48	    (presentation: "image" | "interactive") =>
    49	    async (input: CircuitInput): Promise<CallToolResult> => {
    50	      try {
