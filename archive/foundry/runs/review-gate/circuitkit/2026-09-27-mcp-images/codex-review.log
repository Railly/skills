     5	import { recipeSchema } from "../schema.ts";
     6	
     7	export const circuitInputSchema = z.strictObject({
     8	  recipe: recipeSchema.optional(),
     9	  document: z.record(z.string(), z.unknown()).optional(),
    10	  source: z.string().min(1).max(65_536).optional(),
    11	});
    12	
    13	export type CircuitInput = z.infer<typeof circuitInputSchema>;
    14	export type Selection = { kind: "component" | "net" | "module" | "scene"; id: string } | null;
    15	
    16	export function prepareCircuit(input: CircuitInput) {
    17	  const parsed = circuitInputSchema.parse(input);
    18	  if (
    19	    [parsed.recipe, parsed.document, parsed.source].filter((value) => value !== undefined).length >
    20	    1
    21	  )
    22	    throw new Error(
    23	      "Provide exactly one of recipe, document or source, or omit all for the RC demo.",
    24	    );
    25	  if (new TextEncoder().encode(JSON.stringify(parsed)).length > 65_536)
    26	    throw new Error("Circuit input exceeds 64 KiB.");
    27	  if (parsed.source !== undefined) {
    28	    const result = renderCircuitSource(parsed.source);
    29	    if (!result.ok) throw new Error(JSON.stringify(result.diagnostics));
    30	    return { kind: "source" as const, input: { source: parsed.source }, result };
    31	  }
    32	  const result = renderSchematicSVG(parsed.document ?? loadExample(parsed.recipe ?? "rc-lowpass"));
    33	  if (!result.ok) throw new Error(JSON.stringify(result.diagnostics));
    34	  return {
    35	    kind: "recipe" as const,
    36	    input: { document: result.document },
    37	    result,
    38	  };
    39	}
    40	
    41	export type PreparedCircuit = ReturnType<typeof prepareCircuit>;
    42	
    43	export function circuitSummary(circuit: PreparedCircuit) {
    44	  return circuit.kind === "recipe"
    45	    ? {
    46	        title: circuit.result.document.presentation.title,
    47	        kind: circuit.kind,
    48	        components: circuit.result.circuit.components,
    49	        nets: circuit.result.circuit.nets,
    50	        scenes:
    51	          circuit.result.document.presentation.steps?.map(({ id, title }) => ({ id, title })) ?? [],
    52	      }
    53	    : {
    54	        title: circuit.result.figure.title,
    55	        kind: circuit.kind,
    56	        modules: circuit.result.document.modules,
    57	        nets: circuit.result.semantics.nets,
    58	        scenes:
    59	          circuit.result.presentation?.scenes.map(({ id, label, unavailable }) => ({
    60	            id,
    61	            title: label,
    62	            unavailable,
    63	          })) ?? [],
    64	      };
    65	}
    66	
    67	export function selectionContext(circuit: PreparedCircuit, selection: Selection) {
    68	  if (selection) {
    69	    const valid =
    70	      circuit.kind === "recipe"
    71	        ? selection.kind === "component"
    72	          ? Object.hasOwn(circuit.result.circuit.components, selection.id)
    73	          : selection.kind === "net"
    74	            ? Object.hasOwn(circuit.result.circuit.nets, selection.id)
    75	            : selection.kind === "scene" &&
    76	              circuit.result.document.presentation.steps?.some(({ id }) => id === selection.id)
    77	        : selection.kind === "module"
    78	          ? circuit.result.document.modules.some(({ id }) => id === selection.id)
    79	          : selection.kind === "scene" &&
    80	            circuit.result.presentation?.scenes.some(({ id }) => id === selection.id);
    81	    if (!valid) throw new Error("Selection does not belong to this circuit.");
    82	  }
    83	  return {
    84	    selection,
    85	    circuit: circuitSummary(circuit),
    86	  };
    87	}

