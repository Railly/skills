   280	function Viewer() {
   281	  const [data, setData] = useState<{ id: string; circuit: PreparedCircuit } | null>(null);
   282	  const [error, setError] = useState("");
   283	  const [connected, setConnected] = useState(false);
   284	  useEffect(() => {
   285	    const clearContext = () => {
   286	      if (app.getHostCapabilities()?.updateModelContext)
   287	        void app
   288	          .updateModelContext({
   289	            content: [
   290	              {
   291	                type: "text",
   292	                text: "CircuitKit has no active circuit selection. The previous selection is no longer current.",
   293	              },
   294	            ],
   295	          })
   296	          .catch(() => {});
   297	    };
   298	    app.ontoolinput = () => {
   299	      setData(null);
   300	      setError("");
   301	      clearContext();
   302	    };
   303	    app.ontoolcancelled = () => {
   304	      setData(null);
   305	      setError("Circuit request cancelled.");
   306	      clearContext();
   307	    };
   308	    app.ontoolresult = (result) => {
   309	      setData(null);
   310	      try {
   311	        if (result.isError)
   312	          throw new Error(
   313	            result.content
   314	              ?.filter((part) => part.type === "text")
   315	              .map((part) => part.text)
   316	              .join("\n") || "Invalid circuit.",
   317	          );
   318	        const payload = payloadSchema.parse(result._meta?.circuitkit);
   319	        const circuit = prepareCircuit(payload.input);
   320	        setData({ id: payload.id, circuit });
   321	        setError("");
   322	      } catch (failure) {
   323	        setError(failure instanceof Error ? failure.message : "Invalid circuit result.");
   324	        clearContext();
   325	      }
   326	    };
   327	    const theme = () => {
   328	      document.documentElement.dataset.theme = app.getHostContext()?.theme ?? "light";
   329	    };
   330	    app.onhostcontextchanged = theme;
   331	    app.connect().then(
   332	      () => {
   333	        setConnected(true);
   334	        theme();
   335	      },
   336	      () => setError("The MCP Apps host connection failed."),
   337	    );
   338	    return () => {
   339	      void app.close();
   340	    };
   341	  }, []);
   342	  if (error)
   343	    return (
   344	      <main>
   345	        <h1>Circuit unavailable</h1>
