  "findings": [
    {
      "id": "F1",
      "priority": "P1",
      "state": "confirmed",
      "claim": "Propagate compound patch validation to renderer stream handlers. The new getByPath/setByPath rejection outcomes are not handled by the older renderer applyPatch implementations. Built React useUIStream processing move from /state/source to /state/items/01 removes source then silently rejects its destination. Copy/move from /state/items/01 to a valid key creates an own undefined property. Core applySpecStreamPatch safely rejects the same compound patches, but these handlers bypass it. This introduces data loss when noncanonical input previously coerced to index 1.",
      "evidence": "coordinator/hook-proof.test.ts; coordinator/hook-proof-head.json; caller-contexts.txt; coordinator/hook-proof-base-public.json; public-export-review.json",
      "layer": "built public React consumer and observable state",
      "source": "lens",
      "path": "packages/react/src/hooks.ts:186",
      "changed_location": {
        "path": "packages/core/src/types.ts",
        "line_start": 340,
        "line_end": 341
      },
      "resolution": "open",
      "recommendation": "Route all public streaming patch handlers through the safe compound helper, or validate source and post-removal destination before mutating."
    },
    {
      "id": "F2",
      "priority": "P2",
      "state": "confirmed",
      "claim": "Exclude rejected batch entries from state-provider change callbacks. After update({\"/items/01\":\"rejected\",\"/count\":1}), new core state correctly preserves items but StateProvider onStateChange reports both entries because it compares submitted values with the old snapshot. Applications persisting callbacks receive a write that never occurred. Exact base executed the coerced array write, so the same callback matched its state; the new rejection exposes this mismatch.",
      "evidence": "consumer/result.json; resumed-caller-review/base-invalid-result.json; resumed-caller-review/base-invalid-probe.mjs; resumed-caller-review/base-invalid.log",
      "layer": "built public React consumer and observable state",
      "source": "lens",
      "path": "packages/react-state/src/index.tsx:156",
      "changed_location": {
        "path": "packages/core/src/state-store.ts",
        "line_start": 160,
        "line_end": 168
      },
      "resolution": "open",
      "recommendation": "Derive emitted change records from accepted writes and the committed state, preserving append and sequential batch semantics."
    },
